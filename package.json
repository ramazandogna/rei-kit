{
  "name": "rei-kit",
  "version": "0.0.0",
  "description": "Vue 3 and Tailwind 4 design system and shared runtime. Extracted from Hibi.",
  "license": "MIT",
  "author": "Ramazan Do\u011fan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramazandogna/rei-kit.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "import": "./dist/supabase.js"
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite build --watch",
    "build": "run-s type-check build-only",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:unit": "vitest",
    "test:ci": "vitest run",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "check": "run-s check:format check:lint type-check test:ci build-only",
    "check:format": "prettier --check src/",
    "check:lint": "run-s check:lint:*",
    "check:lint:oxlint": "oxlint .",
    "check:lint:eslint": "eslint .",
    "format": "prettier --write src/",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "lucide-vue-next": "^1.0.0",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0",
    "vue-i18n": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "vue-i18n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.80.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "lucide-vue-next": "^1.0.0",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.10",
    "vue-tsc": "^3.3.7"
  }
}
