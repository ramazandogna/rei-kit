{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["showcase/**/*", "showcase/**/*.vue", "src/**/*", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "rei-kit": ["./src/index.ts"],
      "rei-kit/web": ["./src/web/index.ts"],
      "rei-kit/app": ["./src/app/index.ts"],
      "rei-kit/pwa": ["./src/pwa/index.ts"],
      "rei-kit/motion": ["./src/motion/index.ts"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.showcase.tsbuildinfo"
  }
}
